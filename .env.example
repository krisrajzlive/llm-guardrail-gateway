# Copy to .env (git-ignored) for local live runs. Never commit real keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Optional: native LangSmith traces in addition to the built-in JSON span events
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=llm-guardrail-gateway

# Optional model overrides (provider:model)
# LLM_MODEL_OPENAI=openai:gpt-5.5
# LLM_MODEL_ANTHROPIC=anthropic:claude-opus-4-8
# LLM_MODEL_GOOGLE=google_genai:gemini-3.1-pro-preview
