# No third-party API keys are needed: all models run on Amazon Bedrock via the AWS credential chain.
# Locally, sign in (e.g. `aws login` / SSO) and select a profile and region:
AWS_PROFILE=
AWS_REGION=us-east-1

# Optional: native LangSmith traces in addition to the built-in JSON span events
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=llm-guardrail-gateway

# Optional model overrides (bedrock_converse:<model or inference-profile id>)
# LLM_MODEL_CLAUDE=bedrock_converse:us.anthropic.claude-haiku-4-5-20251001-v1:0
# LLM_MODEL_NOVA=bedrock_converse:us.amazon.nova-lite-v1:0
# LLM_MODEL_LLAMA=bedrock_converse:us.meta.llama3-1-8b-instruct-v1:0
